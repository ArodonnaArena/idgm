{
  "name": "idgm-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "backend/*"
  ],
  "scripts": {
    "dev:web": "cd apps/web && npm run dev",
    "dev:admin": "cd apps/admin && npm run dev",
    "dev:api": "cd backend/api && npm run dev",
    "dev:all": "concurrently -n API,ADMIN,WEB -c green,blue,magenta \"npm:dev:api\" \"npm:dev:admin\" \"npm:dev:web\"",
    "dev:site": "concurrently -n API,WEB -c green,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "build:web": "cd apps/web && npm run build",
    "build:admin": "cd apps/admin && npm run build",
    "build:api": "cd backend/api && npm run build",
    "db:supabase:apply": "npx supabase db push --project-ref YOUR_PROJECT_REF",
    "db:supabase:seed": "node scripts/seed-supabase.js",
    "install:all": "npm install"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "concurrently": "^9.2.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "dotenv": "^17.2.3"
  }
}
