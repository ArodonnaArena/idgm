# Backend API URL (REQUIRED for production)
# Your NestJS backend deployed on Render
# Example: https://your-backend-app.onrender.com
NEXT_PUBLIC_BACKEND_URL=

# Supabase PostgreSQL configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_your_anon_key
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=replace_with_your_anon_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_your_service_role_key

# NextAuth Configuration
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Payment Providers (if used in frontend)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
