{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Admin TypeScript configuration",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "compilerOptions": {
      "type": "object",
      "additionalProperties": true
    },
    "include": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exclude": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "compilerOptions"
  ],
  "additionalProperties": false
}
