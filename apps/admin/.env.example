# Supabase PostgreSQL configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_your_anon_key
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=replace_with_your_anon_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_your_service_role_key

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=replace_with_a_long_random_string

# Frontend URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend API Configuration
# For LOCAL DEVELOPMENT: Use localhost backend
# NEXT_PUBLIC_API_URL=http://localhost:4000/api

# For PRODUCTION (Vercel): Use Render backend
NEXT_PUBLIC_API_URL=https://idgm-backend.onrender.com/api
NEXT_PUBLIC_BACKEND_URL=https://idgm-backend.onrender.com

